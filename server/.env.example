# Copy to .env (npm run setup does this for you and generates a random secret).

# PostgreSQL. Create the user and database once (see docs/SETUP.md, "PostgreSQL"), then put the password here.
# The development user needs CREATEDB so the tests can create their own temporary databases.
DATABASE_URL="postgresql://skans:CHANGE_ME@localhost:5432/skans_qb?schema=public"

# Folder for `npm run db:backup` (default: server/backups) and how many daily backups to keep.
# BACKUP_DIR=D:/SKANS-backups
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_MONTHLY=6
# Optional second copy of every backup (e.g. a OneDrive/Google Drive folder or a USB drive).
# BACKUP_COPY_DIR=
# Folder with PostgreSQL's pg_dump / pg_restore if they are not on PATH.
# PG_BIN=C:/Program Files/PostgreSQL/17/bin

# Long random string used to sign session cookies. NEVER commit the real value.
SESSION_SECRET=change-me

# HTTP port of the API server
PORT=4000

# Set to "production" on the school server (enables secure cookies - requires HTTPS via Nginx)
NODE_ENV=development

# Origin of the web client during development (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind Nginx so client IPs and HTTPS are detected correctly
TRUST_PROXY=0

# Login protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Session lifetime (minutes of inactivity)
SESSION_TTL_MINUTES=480

# Optional: folder containing the SKANS logo files (skans-logo.jpg for papers).
# Relative to the server folder. Defaults to ../client/public/branding. Papers print a logo only
# when such a file exists.
# BRANDING_DIR=../client/public/branding
