{
  "name": "@skans/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e:run": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only --name",
    "db:reset": "prisma migrate deploy && tsx prisma/seed.ts --reset",
    "db:copy-from-sqlite": "tsx scripts/sqlite-to-postgres.ts",
    "db:seed": "tsx prisma/seed.ts",
    "pdf:samples": "tsx scripts/generate-samples.ts",
    "demo:paper": "tsx scripts/demo-paper.ts",
    "data:cleanup": "tsx scripts/cleanup-data.ts",
    "docs:guide": "tsx scripts/guide/make-guide.ts",
    "docs:tunnel-guide": "tsx scripts/guide/make-tunnel-guide.ts",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:verify-backup": "tsx scripts/restore-db.ts --verify",
    "db:restore": "tsx scripts/restore-db.ts",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.2.8",
    "@fontsource/carlito": "^5.2.8",
    "@fontsource/tinos": "^5.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@skans/shared": "*",
    "bcryptjs": "^3.0.2",
    "cross-env": "^10.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-html-parser": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.0",
    "prisma": "^7.10.1",
    "sanitize-html": "^2.17.0",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "pdfjs-dist": "4.10.38",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
