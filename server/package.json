{
  "name": "@skans/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:reset": "prisma db push --skip-generate && tsx prisma/seed.ts --reset",
    "db:seed": "tsx prisma/seed.ts",
    "pdf:samples": "tsx scripts/generate-samples.ts",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.2.8",
    "@fontsource/carlito": "^5.2.8",
    "@fontsource/tinos": "^5.2.8",
    "@prisma/client": "6.19.3",
    "@skans/shared": "*",
    "bcryptjs": "^3.0.2",
    "cross-env": "^10.0.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-html-parser": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.0",
    "prisma": "6.19.3",
    "sanitize-html": "^2.17.0",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "pdfjs-dist": "4.10.38",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
