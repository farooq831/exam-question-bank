# Production settings for the school server. Copy to server/.env (or set these in the service
# environment) and keep the real file OUT of version control. Never reuse the development secret.

NODE_ENV=production

# Port the Node process listens on. Expose it only to Nginx on the same machine (127.0.0.1).
PORT=4000
# Listen only on this computer; Nginx or Cloudflare Tunnel on the same machine forwards visitors to it.
HOST=127.0.0.1

# PostgreSQL on the same machine. The production user does NOT need CREATEDB.
DATABASE_URL="postgresql://skans:CHANGE_ME@127.0.0.1:5432/skans_qb?schema=public"

# Nightly backups (`npm run db:backup`, scheduled with server/scripts/schedule-backup.ps1).
BACKUP_DIR=/srv/skans/backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=6
# Second copy on another disk or a synced cloud folder:
# BACKUP_COPY_DIR=/mnt/offsite/skans

# 64+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Public HTTPS origin of the application (used for documentation and future CORS settings).
CLIENT_ORIGIN=https://qb.skans.local

# Required behind Nginx so HTTPS and client IP addresses are detected (Secure cookies need it).
TRUST_PROXY=1

# Login protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Idle session lifetime in minutes
SESSION_TTL_MINUTES=480

# Folder with the SKANS logo files (copy client/public/branding there). Back it up with the database.
# Optional: initial admin password used only when the seed creates the first administrator.
# SKANS_ADMIN_PASSWORD=
BRANDING_DIR=/srv/skans/branding
